---
import { getCollection, render } from 'astro:content';

interface Props {
  empty: string;
  filterLabel: string;
  allModules: string;
}

// Same-day releases are ordered by version, which a string compare gets wrong (0.10.0 < 0.9.0).
const versionParts = (version: string) => version.split(/[.-]/).map((part) => Number.parseInt(part, 10) || 0);
const compareVersions = (a: string, b: string) => {
  const [pa, pb] = [versionParts(a), versionParts(b)];
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const diff = (pa[i] ?? 0) - (pb[i] ?? 0);
    if (diff !== 0) return diff;
  }
  return 0;
};

const releases = (await getCollection('releases')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || compareVersions(b.data.version, a.data.version),
);
const rendered = await Promise.all(releases.map(async (release) => ({ release, ...(await render(release)) })));
const modules = [...new Set(releases.map((release) => release.data.module))].sort();
---

{rendered.length === 0 && <p>{Astro.props.empty}</p>}
{
  modules.length > 1 && (
    <label class="release-filter">
      {Astro.props.filterLabel}{' '}
      <select id="release-module">
        <option value="">{Astro.props.allModules}</option>
        {modules.map((module) => (
          <option value={module}>{module}</option>
        ))}
      </select>
    </label>
  )
}
{
  rendered.map(({ release, Content }) => (
    <section class="release" data-module={release.data.module}>
      <h2 id={release.data.tag.replace(/[^a-z0-9-]/gi, '-')}>
        {release.data.module} {release.data.version}
      </h2>
      <p>
        <time datetime={release.data.date.toISOString()}>{release.data.date.toISOString().slice(0, 10)}</time> ·{' '}
        <a href={`https://github.com/l2nx/nx-gs-adapter/releases/tag/${release.data.tag}`}>{release.data.tag}</a>
      </p>
      <Content />
    </section>
  ))
}

<script>
  const select = document.querySelector<HTMLSelectElement>('#release-module');
  select?.addEventListener('change', () => {
    for (const section of document.querySelectorAll<HTMLElement>('section.release')) {
      section.hidden = select.value !== '' && section.dataset.module !== select.value;
    }
  });
</script>
